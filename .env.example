# Copy to `.env` for `npm run dev` (Nuxt loads it automatically).
# Never commit `.env`: it is git-ignored and excluded from Docker builds.

# ── Database ─────────────────────────────────────────────
# Local MongoDB from `docker compose up mongo`:
MONGODB_URI=mongodb://campusworks:campusworks-dev@localhost:27017/?authSource=admin
MONGODB_DB=campusworks

# ── Sessions ─────────────────────────────────────────────
# Secret used to encrypt/sign the session cookie (32+ characters).
# Required in production, and must be identical on every replica.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Sign-in ──────────────────────────────────────────────
# Demo login (pick student / TA / instructor / admin without a password).
# Defaults to true in development and false in production builds.
ENABLE_MOCK_LOGIN=true

# Comma-separated emails that are site admins (create/delete courses).
ADMIN_EMAILS=

# Optional GitLab OAuth (gitlab.com or a self-hosted GitLab).
# Register an application with redirect URI <your-origin>/api/auth/gitlab
# and the `read_user` scope.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Optional comma-separated allow-list of email domains for OAuth sign-in,
# e.g. "example.edu,example.com". Empty allows every domain.
ALLOWED_EMAIL_DOMAINS=

# ── Demo data ────────────────────────────────────────────
# Seed demo courses/accounts on first start when the database is empty.
SEED_DEMO_DATA=false
