# Private local settings for npm run dev. Never commit a populated .env.
# Start the local replica set with: docker compose up -d mongo-init
MONGODB_URI=mongodb://campusworks:campusworks-dev@localhost:27017/?authSource=admin&replicaSet=rs0&directConnection=true
MONGODB_DB=campusworks

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production and identical on all app replicas.
SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
TRUST_PROXY=false
MAX_BODY_BYTES=12582912
API_RATE_LIMIT=1800
LOGIN_RATE_LIMIT=300

# Local demonstration only. Disable both in institutional environments.
ENABLE_MOCK_LOGIN=true
SEED_DEMO_DATA=false
ADMIN_EMAILS=

# Optional OAuth. Register <origin>/api/auth/gitlab, read_user scope.
GITLAB_BASE_URL=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=

# OpenAI requires only a private Key with these defaults.
# Other providers must explicitly supply their base URL and model.
# Base URL must expose /chat/completions; use HTTPS externally.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_DAILY_REQUEST_LIMIT=20
AI_DAILY_TOKEN_BUDGET=100000
AI_GLOBAL_DAILY_REQUEST_LIMIT=200
AI_GLOBAL_DAILY_TOKEN_BUDGET=1000000
AI_MAX_CONCURRENT=2
# Automatic advisory tasks; ordinary reads never purchase a model call.
AI_AUTO_REFRESH_ENABLED=true
AI_AUTO_DISCOVERY_ENABLED=true
AI_AUTO_CANDIDATE_PAGE_SIZE=10
AI_TERM_REVIEW_COOLDOWN_MS=900000

# Appointment dates and in-app delivery run independently of AI configuration.
STAFFING_MAINTENANCE_ENABLED=true
STAFFING_MAINTENANCE_INTERVAL_MS=5000
