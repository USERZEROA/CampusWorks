{
  "name": "campusworks",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt prepare && vue-tsc --build --noEmit && tsc --project playwright/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "demo:windows": "node scripts/demo-windows.mjs"
  },
  "dependencies": {
    "mongodb": "^7.0.0",
    "nuxt": "^4.2.1",
    "vue": "^3.5.22",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.1"
  }
}
