{
  "name": "campusworks",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "start:ai": "node scripts/start-with-ai.mjs",
    "dev:ai": "node scripts/start-with-ai.mjs --dev",
    "check:ai": "node scripts/start-with-ai.mjs --check",
    "typecheck": "nuxt prepare && vue-tsc --build --noEmit && tsc --project playwright/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "demo:windows": "node scripts/demo-windows.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "verify:local": "node scripts/local-test.mjs"
  },
  "dependencies": {
    "deepmerge": "file:vendor/safe-deepmerge",
    "mongodb": "7.8.0",
    "nuxt": "4.6.4",
    "vue": "^3.5.22",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.1"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  }
}
